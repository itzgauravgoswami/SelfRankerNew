# Self Ranker — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# ─── Backend API ─────────────────────────────────────────────────────────────
# URL of the backend API server (include /api suffix)
VITE_API_BASE_URL=http://localhost:3000/api

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── YouTube Data API v3 (optional) ─────────────────────────────────────────
# Get your key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# If not provided, a YouTube search link is shown as fallback
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/applications/new
VITE_GITHUB_CLIENT_ID=your_github_client_id

# ─── Microsoft OAuth ─────────────────────────────────────────────────────────
# Register an app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id

# ─── Razorpay (Payment Gateway) ──────────────────────────────────────────────
# Get your keys at: https://dashboard.razorpay.com/app/keys
# Use the KEY ID (starts with rzp_test_ or rzp_live_) — never the secret
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
